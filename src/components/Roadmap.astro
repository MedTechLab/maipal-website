---
const phases = [
  {
    n: "MVP",
    when: "0–6 months",
    title: "Free MVP",
    body: "Validate product-market fit in Hong Kong. Core 望闻问切 dialogue and daily plan.",
    accent: "shiqing",
  },
  {
    n: "Growth",
    when: "6–12 months",
    title: "Hospital & Healthcare",
    body: "Premium tier opens. Clinic partnerships and verified Chinese-medicine practitioners.",
    accent: "gold",
  },
  {
    n: "Ecosystem",
    when: "12–24 months",
    title: "TCM E-commerce & Education",
    body: "Closed-loop wellness products, insurance partnerships, education content for long-term care.",
    accent: "shiqing",
  },
];

const markets = [
  { phase: "Phase 1", year: "2026", focus: "Hong Kong as Foundation", body: "Establish product-market fit and operational model in the initial launch market." },
  { phase: "Phase 2", year: "2028", focus: "Greater Bay Area Expansion", body: "Leverage Hong Kong experience to rapidly expand into major cities of the Pearl River Delta." },
  { phase: "Phase 3", year: "2030", focus: "Tier 1 & 2 Cities, Mainland China", body: "Replicate the Hong Kong coverage model across mainland Chinese tier-1 and tier-2 cities." },
];
---

<section class="section roadmap" id="roadmap">
  <div class="wrap">
    <div class="section-head">
      <div class="eyebrow">Ecosystem & Roadmap</div>
      <h2 class="section-title">A three-phase path from Hong Kong outward.</h2>
    </div>

    <div class="roadmap-block">
      <h3 class="block-h">Ecosystem development</h3>
      <div class="phases">
        {phases.map((p, i) => (
          <div class={`phase phase--${p.accent}`}>
            <div class="phase-rail">
              <div class="phase-dot">{i + 1}</div>
              {i < phases.length - 1 && <div class="phase-line"></div>}
            </div>
            <div class="phase-body">
              <div class="phase-when">{p.n} · {p.when}</div>
              <h4>{p.title}</h4>
              <p>{p.body}</p>
            </div>
          </div>
        ))}
      </div>
    </div>

    <div class="roadmap-block">
      <h3 class="block-h">Market expansion</h3>
      <div class="markets">
        {markets.map((m, i) => (
          <article class="market">
            <div class="market-year">{m.year}</div>
            <div class="market-tag">{m.phase}</div>
            <h4>{m.focus}</h4>
            <p>{m.body}</p>
          </article>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .roadmap { padding-top: 56px; padding-bottom: 80px; }
  .section-head { max-width: 720px; margin: 0 auto 56px; text-align: center; }
  .section-head .eyebrow { margin-bottom: 16px; }
  .section-title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 32px;
    line-height: 1.25;
    color: var(--ink);
    margin: 0;
  }

  .roadmap-block { margin-bottom: 48px; }
  .roadmap-block:last-child { margin-bottom: 0; }
  .block-h {
    font-family: var(--font-display);
    font-size: 20px;
    color: var(--ink);
    margin: 0 0 24px;
    text-align: center;
  }
  .phases {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0;
    background: rgba(255, 255, 255, 0.7);
    border: 1.18px solid var(--hairline);
    border-radius: var(--radius-lg);
    padding: 24px;
    backdrop-filter: blur(4px);
  }
  .phase {
    display: grid;
    grid-template-columns: 40px 1fr;
    padding: 8px 16px;
    align-items: start;
  }
  .phase-rail { position: relative; display: flex; flex-direction: column; align-items: center; height: 100%; }
  .phase-dot {
    width: 32px; height: 32px;
    border-radius: 999px;
    background: var(--shiqing);
    color: #fff;
    text-align: center;
    line-height: 32px;
    font-size: 13px;
    font-weight: 600;
    box-shadow: 0 4px 10px rgba(123,140,118,0.32);
    z-index: 2;
  }
  .phase--gold .phase-dot {
    background: linear-gradient(135deg, var(--gold) 0%, var(--gold-bright) 100%);
    box-shadow: 0 4px 10px rgba(212,165,116,0.4);
  }
  .phase-line { flex: 1; width: 2px; background: var(--hairline); margin-top: 4px; }
  .phase-when {
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--shiqing);
    font-weight: 500;
    margin-bottom: 6px;
  }
  .phase--gold .phase-when { color: var(--xuanzhi-dark); }
  .phase h4 {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 16px;
    color: var(--ink);
    margin: 0 0 8px;
  }
  .phase p {
    margin: 0;
    font-size: 13px;
    line-height: 1.65;
    color: var(--ink-muted);
  }

  .markets {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }
  .market {
    background: rgba(255, 255, 255, 0.92);
    border: 1.18px solid var(--hairline);
    border-radius: var(--radius-lg);
    padding: 28px 24px;
    position: relative;
    box-shadow: 0 4px 14px rgba(107, 93, 79, 0.08);
    overflow: hidden;
  }
  .market::before {
    content: "";
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 4px;
    background: linear-gradient(90deg, var(--shiqing) 0%, var(--shilv) 100%);
  }
  .market:nth-child(2)::before { background: linear-gradient(90deg, var(--gold) 0%, var(--gold-bright) 100%); }
  .market:nth-child(3)::before { background: linear-gradient(90deg, var(--xuanzhi-warm) 0%, var(--xuanzhi-dark) 100%); }
  .market-year {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 36px;
    color: var(--shiqing);
    line-height: 1;
    margin-bottom: 6px;
  }
  .market:nth-child(2) .market-year { color: var(--xuanzhi-dark); }
  .market-tag {
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-muted);
    margin-bottom: 16px;
  }
  .market h4 {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 16px;
    color: var(--ink);
    margin: 0 0 8px;
  }
  .market p {
    font-size: 13px;
    line-height: 1.65;
    color: var(--ink-muted);
    margin: 0;
  }

  @media (max-width: 920px) {
    .phases, .markets { grid-template-columns: 1fr; }
    .section-title { font-size: 26px; }
    .phases { padding: 16px; gap: 8px; }
  }
</style>
