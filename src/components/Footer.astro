---
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="wrap footer-inner">
    <div class="foot-brand">
      <div class="foot-mark">
        <span class="foot-glyph">脉</span>
        <div>
          <div class="foot-name">MaiPal · 脉伴</div>
          <div class="foot-sub" data-i18n="foot.sub">Your TCM Health Companion</div>
        </div>
      </div>
      <p class="foot-tag">为了下一个五十年。For the next 50 years.</p>
    </div>
    <div class="foot-cols">
      <div>
        <div class="foot-h" data-i18n="foot.col1.h">Project</div>
        <a href="/#solution" data-i18n="foot.col1.l1">Solution</a>
        <a href="/#product" data-i18n="foot.col1.l2">Product</a>
        <a href="/#preview" data-i18n="foot.col1.l3">App preview</a>
      </div>
      <div>
        <div class="foot-h" data-i18n="foot.col2.h">Showcase</div>
        <a href="/slideshow" data-i18n="foot.col2.l1">Annual show</a>
        <a href="/#team" data-i18n="foot.col2.l2">Team</a>
      </div>
      <div>
        <div class="foot-h" data-i18n="foot.col3.h">Affiliation</div>
        <a href="https://www.polyu.edu.hk/sd/" target="_blank" rel="noopener" data-i18n="foot.col3.l1">School of Design, PolyU</a>
        <span>MedTech Lab</span>
      </div>
    </div>
  </div>
  <div class="wrap foot-bot">
    <span data-i18n="foot.copyright">&copy; {year} MaiPal &middot; MedTech Lab, School of Design, The Hong Kong Polytechnic University.</span>
    <span data-i18n="foot.coming">app.maipal.org &middot; coming soon</span>
  </div>
</footer>

<style>
  .site-footer {
    background: linear-gradient(180deg, rgba(232, 193, 124, 0.06) 0%, rgba(123, 140, 118, 0.10) 100%);
    border-top: 1.18px solid var(--hairline);
    padding: 64px 0 24px;
    margin-top: 80px;
  }
  .footer-inner {
    display: grid;
    grid-template-columns: 1.3fr 2fr;
    gap: 48px;
    padding-bottom: 40px;
  }
  .foot-mark { display: flex; align-items: center; gap: 14px; }
  .foot-glyph {
    width: 48px;
    height: 48px;
    border-radius: 12px;
    background: linear-gradient(180deg, var(--shiqing) 0%, var(--shiqing) 8px, #fff 8px);
    color: var(--shiqing);
    font-family: var(--font-brush);
    font-size: 30px;
    line-height: 48px;
    text-align: center;
    border: 1.18px solid var(--hairline);
    box-shadow: 0 3px 8px rgba(123,140,118,0.16);
  }
  .foot-name { font-family: var(--font-display); font-weight: 700; font-size: 18px; color: var(--ink); }
  .foot-sub { font-size: 13px; color: var(--ink-muted); margin-top: 2px; }
  .foot-tag { font-family: var(--font-brush); color: var(--shiqing); margin-top: 14px; font-size: 18px; }
  .foot-cols { display: grid; grid-template-columns: repeat(3, 1fr); gap: 32px; }
  .foot-cols .foot-h { font-size: 12px; letter-spacing: 0.12em; text-transform: uppercase; color: var(--shiqing); font-weight: 500; margin-bottom: 14px; }
  .foot-cols a, .foot-cols span {
    display: block;
    font-size: 14px;
    color: var(--ink-muted);
    padding: 4px 0;
    transition: color 150ms var(--ease);
  }
  .foot-cols a:hover { color: var(--shiqing); }
  .foot-bot {
    display: flex;
    justify-content: space-between;
    border-top: 1.18px solid var(--hairline);
    padding-top: 20px;
    font-size: 12px;
    color: var(--ink-muted);
  }
  @media (max-width: 720px) {
    .footer-inner { grid-template-columns: 1fr; gap: 32px; }
    .foot-cols { grid-template-columns: repeat(2, 1fr); }
    .foot-bot { flex-direction: column; gap: 6px; text-align: center; }
  }
</style>
