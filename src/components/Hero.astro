---
---

<section class="hero">
  <div class="shanshui-bg" aria-hidden="true"></div>
  <div class="wrap hero-grid">
    <div class="hero-copy">
      <div class="eyebrow">PolyU · School of Design · MedTech Lab</div>
      <h1 class="hero-title">
        <span class="hero-name brush">MaiPal</span>
        <span class="hero-cn brush">脉伴</span>
      </h1>
      <p class="hero-sub display">
        Intelligent Traditional Chinese Medicine<br />Health Companion Agent
      </p>
      <p class="hero-lede">
        An AI wellness companion designed around the logic of 望闻问切.<br />
        A warm, trustworthy guide for adults 45–65 navigating sub-health.
      </p>
      <div class="hero-ctas">
        <a class="btn btn-primary" href="#preview">See the app</a>
        <a class="btn btn-ghost" href="/slideshow">Open slideshow</a>
      </div>
      <div class="hero-meta">
        <span>app.maipal.org · coming soon</span>
        <span class="dot" aria-hidden="true">·</span>
        <span>下一个五十年</span>
      </div>
    </div>

    <div class="hero-art">
      <img src="/assets/doctor-maipal.png" alt="脉医生 — Doctor Pulse, MaiPal's TCM companion" class="hero-doctor" />
      <div class="hero-art-decor" aria-hidden="true">
        <div class="floating-card">
          <div class="fc-row"><span class="dot-pulse"></span><span>气色略偏淡</span></div>
          <div class="fc-row muted">2026 · 5月 · 调理报告</div>
        </div>
        <div class="floating-points">
          <span class="pt-icon">★</span>
          <span class="pt-text">+10 积分</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding: 80px 0 96px;
    overflow: hidden;
    isolation: isolate;
  }
  .shanshui-bg {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg,
        rgba(248, 243, 238, 0) 0%,
        rgba(249, 244, 239, 0.55) 50%,
        rgb(250, 245, 240) 100%),
      url("/assets/bg-shanshui.png") center/cover no-repeat;
    opacity: 0.55;
    z-index: -1;
  }
  .hero-grid {
    display: grid;
    grid-template-columns: 1.05fr 1fr;
    gap: 56px;
    align-items: center;
  }
  .hero-copy .eyebrow { margin-bottom: 22px; }
  .hero-title {
    display: flex;
    align-items: baseline;
    gap: 18px;
    margin: 0 0 16px;
  }
  .hero-name { font-size: 84px; }
  .hero-cn   { font-size: 76px; opacity: 0.92; }
  .hero-sub {
    font-size: 28px;
    line-height: 1.3;
    color: var(--ink-soft);
    margin: 0 0 24px;
    max-width: 480px;
  }
  .hero-lede {
    font-size: 16px;
    line-height: 1.7;
    color: var(--ink-muted);
    max-width: 460px;
    margin: 0 0 32px;
  }
  .hero-ctas { display: flex; gap: 12px; flex-wrap: wrap; margin-bottom: 28px; }
  .hero-meta {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: 13px;
    color: var(--ink-muted);
    font-family: var(--font-sans);
  }
  .hero-meta .dot { color: var(--shiqing); }

  .hero-art {
    position: relative;
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: 460px;
  }
  .hero-doctor {
    max-width: 100%;
    max-height: 520px;
    width: auto;
    filter: drop-shadow(0 24px 36px rgba(86, 64, 38, 0.18));
    animation: float 6s var(--ease-in-out) infinite;
  }
  @keyframes float {
    0%, 100% { transform: translateY(0); }
    50%      { transform: translateY(-8px); }
  }
  .hero-art-decor { position: absolute; inset: 0; pointer-events: none; }
  .floating-card {
    position: absolute;
    top: 14%;
    left: -8%;
    padding: 12px 16px;
    background: rgba(255, 255, 255, 0.95);
    border: 1.18px solid var(--hairline);
    border-radius: 14px;
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.08);
    font-size: 13px;
    color: var(--ink);
    backdrop-filter: blur(6px);
    animation: float 7s var(--ease-in-out) infinite reverse;
  }
  .fc-row { display: flex; align-items: center; gap: 8px; }
  .fc-row.muted { color: var(--ink-muted); font-size: 11px; margin-top: 4px; }
  .dot-pulse {
    width: 8px; height: 8px;
    border-radius: 999px;
    background: var(--gold);
    box-shadow: 0 0 0 3px rgba(212, 165, 116, 0.25);
    animation: pulse 1.5s ease-in-out infinite;
  }
  @keyframes pulse { 0%,100%{transform:scale(1);}50%{transform:scale(1.18);} }
  .floating-points {
    position: absolute;
    bottom: 14%;
    right: 0;
    background: linear-gradient(135deg, var(--gold) 0%, var(--gold-bright) 100%);
    color: #fff;
    padding: 10px 16px;
    border-radius: 999px;
    box-shadow: 0 12px 24px rgba(212, 165, 116, 0.4);
    font-size: 13px;
    font-weight: 500;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    animation: float 5.5s var(--ease-in-out) infinite;
  }
  .pt-icon { color: #fff; }

  @media (max-width: 920px) {
    .hero-grid { grid-template-columns: 1fr; gap: 24px; text-align: center; }
    .hero-title { justify-content: center; }
    .hero-sub, .hero-lede { margin-left: auto; margin-right: auto; }
    .hero-ctas { justify-content: center; }
    .hero-meta { justify-content: center; }
    .hero-art { min-height: 380px; }
    .hero-doctor { max-height: 400px; }
    .hero-name { font-size: 64px; }
    .hero-cn   { font-size: 56px; }
    .hero-sub  { font-size: 22px; }
    .floating-card { left: 0; top: 8%; }
    .floating-points { bottom: 8%; right: 4%; }
  }
</style>
