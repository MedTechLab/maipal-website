---
---

<section class="video-section">
  <div class="wrap">
    <div class="section-head">
      <div class="eyebrow">Our Story</div>
      <h2 class="section-title">
        Introducing MaiPal · 脉伴
      </h2>
      <p class="section-lede">
        Meet the AI wellness companion designed to guide Chinese-speaking adults
        through the sub-health stage with Traditional Chinese Medicine wisdom.
      </p>
    </div>

    <div class="video-container">
      <video
        class="promo-video"
        controls
        controlsList="nodownload"
        preload="metadata"
      >
        <source src="/videos/promo-video.mp4" type="video/mp4" />
        Your browser does not support the video tag.
      </video>
    </div>
  </div>
</section>

<style>
  .video-section {
    padding-top: 72px;
    padding-bottom: 72px;
    background: linear-gradient(
      135deg,
      rgba(250, 245, 240, 0.5) 0%,
      rgba(248, 243, 238, 0.3) 100%
    );
  }

  .section-head {
    max-width: 760px;
    margin: 0 auto 56px;
    text-align: center;
  }

  .section-head .eyebrow {
    margin-bottom: 16px;
  }

  .section-title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 36px;
    line-height: 1.25;
    color: var(--ink);
    margin: 0 0 18px;
  }

  .section-lede {
    font-size: 17px;
    line-height: 1.65;
    color: var(--ink-muted);
    margin: 0;
  }

  .video-container {
    position: relative;
    width: 100%;
    max-width: 900px;
    margin: 0 auto;
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: 0 20px 48px rgba(86, 64, 38, 0.12),
      inset 0 0 0 1px rgba(255, 255, 255, 0.5);
  }

  .promo-video {
    display: block;
    width: 100%;
    height: auto;
    background: #000;
  }


  @media (max-width: 720px) {
    .video-section {
      padding-top: 56px;
      padding-bottom: 56px;
    }

    .section-title {
      font-size: 28px;
    }

    .section-lede {
      font-size: 15px;
    }

    .video-container {
      max-width: calc(100% - 32px);
      margin: 0 16px;
    }
  }
</style>
